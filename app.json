{
  "expo": {
    "name": "MyProject",
    "slug": "MyProject",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Logo.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/Logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#054A29"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/Logo.jpeg",
        "backgroundColor": "#054A29"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kinzuliman.myproject"
    },
    "web": {
      "favicon": "./src/assets/Logo.jpeg"
    },
    "plugins": [
      "expo-video",
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "https://api.yestimeltd.com",
      "eas": {
        "projectId": "51d74baf-dd28-4c05-9031-8a759ba840af"
      }
    }
  }
}
